{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",

    "target": "ES2021",

    "declaration": true,
    "removeComments": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "sourceMap": true,
    "outDir": "./dist",

    "baseUrl": "./src",
    "ignoreDeprecations": "6.0",
    "incremental": true,

    "skipLibCheck": true,
    "strict": true,

    "forceConsistentCasingInFileNames": true
  }
}